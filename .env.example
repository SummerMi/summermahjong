# 广东麻将（推倒胡）后端服务 · 环境变量示例
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，不会提交。
# 所有变量都有默认值，不配置也能直接启动。

# 服务名称（出现在 / 与 /docs 标题）
APP_NAME=广东麻将（推倒胡）后端服务

# 版本号（出现在 /healthz 与 /docs）
VERSION=0.1.0

# 允许跨域的来源，逗号分隔。
# demo 用 *；生产必须收紧成具体域名，例如：
# CORS_ORIGINS=https://demo.example.com,http://localhost:5173
CORS_ORIGINS=*

# 对局数上限，满了淘汰最久未访问的（三种存储都生效）
MAX_GAMES=100

# 对局闲置多少秒后被清理（三种存储都生效）
GAME_TTL_SECONDS=7200

# ── 存储选型（优先级 REDIS_URL > DATABASE_URL > 内存；三个都留空 = 纯内存）──
#
# 1) Redis 存储（需要 pip install -e ".[redis]" 或 docker compose 里的 redis 服务）
#    REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# 2) 关系库（需要装对应驱动：SQLite 自带 aiosqlite，MySQL 需 .[mysql]）
#    SQLite（本地试）：DATABASE_URL=sqlite+aiosqlite:///./data/mahjong.db
#    MySQL（生产）：   DATABASE_URL=mysql+aiomysql://user:pass@127.0.0.1:3306/mahjong
DATABASE_URL=

# 是否打印 SQL 语句（调试用，生产关闭）
DB_ECHO=false

# ── 对局读缓存（cache-aside，可选）──
# 注意：这是「Redis 当缓存」，与上面的 REDIS_URL「Redis 当存储」是两种角色，别混用同一个库。
# 留空 = 不开缓存；两者都配时读走缓存、打牌后删缓存
CACHE_REDIS_URL=
# 0 = 关闭；>0 且 CACHE_REDIS_URL 非空时生效
CACHE_TTL_SECONDS=30

# ── JWT 鉴权（可选，默认关闭）──
# 留空 = 不鉴权（demo/CI 行为不变）；设为非空字符串则对 /api/v1/games* 启用
# Bearer Token + 座位绑定（只能查/打自己座位的对局）
# 生产请用足够长的随机串，例如：python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
