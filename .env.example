# 广东麻将（推倒胡）后端服务 · 环境变量示例
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，不会提交。
# 所有变量都有默认值，不配置也能直接启动。

# 服务名称（出现在 / 与 /docs 标题）
APP_NAME=广东麻将（推倒胡）后端服务

# 版本号（出现在 /healthz 与 /docs）
VERSION=0.1.0

# 允许跨域的来源，逗号分隔。
# demo 用 *；生产必须收紧成具体域名，例如：
# CORS_ORIGINS=https://demo.example.com,http://localhost:5173
CORS_ORIGINS=*

# 内存中同时保留的对局数上限，满了淘汰最久未访问的对局
MAX_GAMES=100

# 对局闲置多少秒后被清理
GAME_TTL_SECONDS=7200

# 持久化数据库连接串。留空 = 纯内存模式（零依赖，默认），
# 填了之后由 lifespan 建表并切换到 SQLAlchemy 实现：
#   SQLite（本地试）：DATABASE_URL=sqlite+aiosqlite:///./data/mahjong.db
#   MySQL（生产）：   DATABASE_URL=mysql+asyncmy://user:pass@127.0.0.1:3306/mahjong
DATABASE_URL=

# 是否打印 SQL 语句（调试用，生产关闭）
DB_ECHO=false
